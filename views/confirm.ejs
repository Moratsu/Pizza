<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirm</title>
</head>
<body>
    <h1>Thank you for your order, <%= order.fname %></h1>
    <h2>Order Summary</h2>
    <h2>Order ID: <%= order.id %></h2>
    <p>Name: <%= order.fname %> <%= order.lname %></p>
    <p>Email: <%= order.email %></p>
    <p>Pickup or Delivery: <%= order.method %></p>
    <p>Toppings: <%= order.toppings %></p>
    <p>Pizza Size: <%= order.size %></p>
    <p>Comment: <%= order.comment %></p>
    <p>Date and Time: <%= order.timestamp %></p>
</body>
</html>